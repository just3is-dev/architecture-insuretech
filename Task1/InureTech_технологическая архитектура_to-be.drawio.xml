ometry x="1641.0" y="144" width="48" height="48" as="geometry" /></mxCell><mxCell id="partners-label-8" value="&lt;div style=&quot;font-size: 1px&quot;&gt;&lt;font style=&quot;font-size:22.58px;font-family:Arial;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;Партнёры&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 1px&quot;&gt;&lt;font style=&quot;font-size:22.58px;font-family:Arial;color:#000000;direction:ltr;letter-spacing:0px;line-height:120%;opacity:1&quot;&gt;(B2B API)&lt;br&gt;&lt;/font&gt;&lt;/div&gt;" style="verticalAlign=bottom;align=center;overflow=width;vsdxID=5;fillColor=none;gradientColor=none;shape=stencil(vVNBDsIgEHwNRwxCjHqu+g9iaUtEaBa09fdSwdpi9dBDb8vOwOwsGcQyW/FaIEqsA3MRjcxdhdgBUSp1JUA6XyF2RCwrDIgSzE3n4VzzjtlVV3PvXmjDPdLdoOQRTrvtavNqnAKXw9mDELkBIhDJaxrJZIy/YRLfbjFvpcVgHHfS6JGu4lAK7GVwoXg5gmwjRP3VjoMpqQcm9tPKs0z0Y6crWcBHqt0PN8tJspXFfmNKdpaBH8tYwML/VPjiE6dCKhXSOMTT+PlWiC47PgE=);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;container=0;" vertex="1" parent="1"><mxGeometry x="1560" y="224" width="210" height="50" as="geometry" /></mxCell><mxCell id="cdn-icon-9" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;container=0;" vertex="1" parent="1"><mxGeometry x="131.0" y="340" width="48" height="48" as="geometry" /></mxCell><mxCell id="cdn-cap-10" value="CDN&lt;br&gt;(кэш статики веб-приложения)" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="392" width="270" height="40" as="geometry" /></mxCell><mxCell id="note-cdn-11" value="&lt;b&gt;Почему CDN, а не мультирегион&lt;/b&gt;&lt;br&gt;Требование «равное время загрузки для всех часовых поясов» закрываем через edge-кэширование статики CDN по точкам присутствия в РФ. Динамические API-запросы всё ещё идут в единственный регион ru-central1 — сознательный компромисс при текущем масштабе (50 GB данных). При росте бизнеса — следующий шаг это мультирегион." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="340" width="380" height="150" as="geometry" /></mxCell><mxCell id="dns-icon-12" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;container=0;" vertex="1" parent="1"><mxGeometry x="1230" y="340" width="44" height="44" as="geometry" /></mxCell><mxCell id="dns-cap-13" value="Cloud DNS" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1160" y="388" width="180" height="30" as="geometry" /></mxCell><mxCell id="alb-icon-14" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;container=0;" vertex="1" parent="1"><mxGeometry x="900" y="340" width="52" height="52" as="geometry" /></mxCell><mxCell id="alb-cap-15" value="Application Load Balancer (L7)&lt;br&gt;HTTP health checks по каждой зоне" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="396" width="300" height="44" as="geometry" /></mxCell><mxCell id="note-lb-16" value="&lt;b&gt;Балансировка и failover (клиент ↔ приложение)&lt;/b&gt;&lt;br&gt;ALB держит активные HTTP health-check’и (например, раз в 5–10 c) к /healthz каждого сервиса в каждой зоне. При недоступности бэкенда зона автоматически выводится из ротации трафика без участия человека — переключение занимает секунды, что с большим запасом укладывается в RTO 45 мин. Cloud DNS используется только для ручного DR-сценария полного отказа региона — это редкий кейс, не основной путь отказоустойчивости." style="rounded=0;whiteS