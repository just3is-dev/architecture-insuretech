="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-64"><mxGeometry x="-0.1" y="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e-66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ns-border-35" target="pgm-border-44"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lbl-67" value="запись (кросс-AZ)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-66"><mxGeometry x="-0.1" y="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e-68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ns-border-35" target="pgs-border-48"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lbl-69" value="чтение (локально)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-68"><mxGeometry x="-0.1" y="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e-70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ns-border-39" target="pgm-border-44"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lbl-71" value="запись (кросс-AZ)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-70"><mxGeometry x="-0.1" y="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e-72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="ns-border-39" target="pga-border-52"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lbl-73" value="чтение (локально)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="e-72"><mxGeometry x="-0.1" y="0" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="note-db-74" value="&lt;b&gt;Конфигурация БД под RTO 45 мин / RPO 15 мин&lt;/b&gt;&lt;br&gt;Managed PostgreSQL HA-кластер: master + синхронная реплика в другой зоне дают RPO ≈ 0 (требование ≤ 15 мин выполняется с большим запасом). Автоматический failover managed-сервиса переключает мастер за 1–2 мин, что укладывается в RTO ≤ 45 мин. Непрерывный WAL и регулярные снапшоты (Cloud Backup) закрывают сценарий логической порчи данных, а не только отказа железа. Асинхронная реплика в AZ3 дополнительно разгружает чтение." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="130" y="1430" width="720" height="170" as="geometry" /></mxCell><mxCell id="note-shard-75" value="&lt;b&gt;Шардирование БД: не применяется&lt;/b&gt;&lt;br&gt;Общий объём данных — 50 GB. Один HA-кластер (master + реплики) с запасом обслуживает такой объём даже при кратном росте. Шардирование добавило бы сложность (роутинг запросов, кросс-шардовые джойны) без ощутимой выгоды при таком масштабе данных — решение сознательно не применять его сейчас." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="890" y="1430" width="620" height="170" as="geometry" /></mxCell><mxCell id="note-strategy-76" value="&lt;b&gt;Масштабирование&lt;/b&gt;&lt;br&gt;Горизонтальное — основная стратегия (HPA для сервисов, реплики для БД). Вертикальное — точка отказа и предел по ресурсам ноды, для отказоустойчивости не годится." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1550" y="1430" width="220" height="170" as="geometry" /></mxCell>
